+install_lamparray() {
+  # The daemon's LampArray backend loads this script at runtime to drive per-key
+  # RGB keyboards (e.g. Acer 05af:666a) that expose no four_zoned_kb sysfs group.
+  # Optional: if absent the daemon simply reports no LampArray backend.
+  echo -e "${YELLOW}Installing LampArray per-key RGB helper...${NC}"
+
+  local src=""
+  local here
+  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+  for candidate in \
+      "${here}/lamparray-kbd/lamparray-kbd" \
+      "${here}/../lamparray-kbd/lamparray-kbd" \
+      "${here}/../../lamparray-kbd/lamparray-kbd" \
+      "./lamparray-kbd/lamparray-kbd"; do
+    if [ -f "$candidate" ]; then
+      src="$candidate"
+      break
+    fi
+  done
+
+  if [ -z "$src" ] && command -v git &> /dev/null; then
+    echo -e "${BLUE}Fetching lamparray-kbd...${NC}"
+    local tmp
+    tmp=$(mktemp -d)
+    if git clone --depth 1 "$LAMPARRAY_REPO" "$tmp/lamparray-kbd" &> /dev/null; then
+      src="$tmp/lamparray-kbd/lamparray-kbd"
+    fi
+  fi
+
+  if [ -z "$src" ] || [ ! -f "$src" ]; then
+    echo -e "${YELLOW}lamparray-kbd not found and could not be fetched.${NC}"
+    echo -e "${YELLOW}Per-key RGB will be unavailable; everything else still works.${NC}"
+    return 0
+  fi
+
+  install -d -m 755 "$LAMPARRAY_DIR"
+  install -m 755 "$src" "$LAMPARRAY_BIN"
+
+  # udev uaccess so the standalone CLI works without root. The daemon runs as
+  # root and does not need this, but installing it costs nothing.
+  if "$LAMPARRAY_BIN" list 2>/dev/null | grep -q .; then
+    "$LAMPARRAY_BIN" install-udev &> /dev/null && \
+      echo -e "${GREEN}LampArray udev rule installed.${NC}"
+    echo -e "${GREEN}LampArray keyboard: $("$LAMPARRAY_BIN" list 2>/dev/null | head -1)${NC}"
+  else
+    echo -e "${BLUE}LampArray helper installed; no LampArray keyboard on this machine.${NC}"
+  fi
+  return 0
+}
+
