--- /dev/null
+++ b/DAMM-Daemon/LampArrayBackend.py
@@ -0,0 +1,389 @@
+#!/usr/bin/env python3
+"""
+LampArrayBackend - per-key RGB backend for DAMX-Daemon.
+
+Drives keyboards that implement the standard HID LampArray protocol (usage page 0x59,
+HUT 1.5 §25 - "Windows Dynamic Lighting"), on laptops where linuwu_sense exposes no
+usable four_zoned_kb sysfs interface.
+
+Why this exists
+---------------
+On the Acer Predator PH16-72 (and siblings that share quirk_acer_predator_v4) the
+keyboard is per-key RGB on a separate USB device (05af:666a), not a four-zone EC
+function. linuwu_sense therefore never creates four_zoned_kb, and the GUI's keyboard
+panels stay hidden with nothing to talk to.
+
+Design
+------
+This follows the precedent already set by the ENEK5130 HID backend in DAMX-Daemon:
+an alternative transport that satisfies the *existing* zone-based contract rather than
+introducing a new protocol. The daemon and GUI keep speaking per_zone_mode /
+four_zone_mode; this module maps those onto real per-key lamp positions.
+
+  per_zone_mode(z1..z4, brightness) -> keyboard split into 4 left-to-right bands
+  four_zone_mode(mode=0, ...)       -> solid colour
+  four_zone_mode(mode=1..7, ...)    -> rendered by a background animation thread,
+                                       because LampArray is a static per-lamp protocol
+                                       with no firmware effect engine
+
+The actual HID transport is reused from `lamparray-kbd` (MIT), imported as a module so
+there is exactly one implementation of the protocol on the system.
+"""
+
+import colorsys
+import glob
+import importlib.machinery
+import importlib.util
+import json
+import logging
+import math
+import os
+import random
+import threading
+import time
+from typing import Dict, List, Optional, Tuple
+
+log = logging.getLogger("DAMXDaemon")
+
+STATE_PATH = "/etc/DAMX_Daemon/lamparray_state.json"
+
+# Where to look for the lamparray-kbd implementation, most-preferred first.
+# Override with LAMPARRAY_KBD_PATH=/path/to/lamparray-kbd
+_SEARCH_PATHS = [
+    "/usr/local/lib/damx/lamparray-kbd",
+    "/usr/local/bin/lamparray-kbd",
+    "/usr/bin/lamparray-kbd",
+    "/opt/lamparray-kbd/lamparray-kbd",
+]
+_SEARCH_GLOBS = [
+    "/home/*/.local/bin/lamparray-kbd",
+    "/home/*/*/lamparray-kbd/lamparray-kbd",
+    "/home/*/*/*/lamparray-kbd/lamparray-kbd",
+    "/home/*/*/*/*/lamparray-kbd/lamparray-kbd",
+]
+
+# four_zone_mode effect ids, as documented by Linuwu-Sense
+MODE_STATIC, MODE_BREATH, MODE_NEON, MODE_WAVE = 0, 1, 2, 3
+MODE_SHIFT, MODE_ZOOM, MODE_METEOR, MODE_TWINKLE = 4, 5, 6, 7
+ANIMATED_MODES = {MODE_BREATH, MODE_NEON, MODE_WAVE, MODE_SHIFT,
+                  MODE_ZOOM, MODE_METEOR, MODE_TWINKLE}
+
+
+def _find_lamparray_module() -> str:
+    """Locate the lamparray-kbd script. Returns '' if not found."""
+    env = os.environ.get("LAMPARRAY_KBD_PATH", "")
+    if env and os.path.isfile(env):
+        return env
+    for p in _SEARCH_PATHS:
+        if os.path.isfile(p):
+            return p
+    for pattern in _SEARCH_GLOBS:
+        for p in sorted(glob.glob(pattern)):
+            if os.path.isfile(p):
+                return p
+    return ""
+
+
+def _load_lamparray():
+    """Import lamparray-kbd as a module (it has no .py extension)."""
+    path = _find_lamparray_module()
+    if not path:
+        return None, ""
+    try:
+        loader = importlib.machinery.SourceFileLoader("_lamparray", path)
+        spec = importlib.util.spec_from_loader("_lamparray", loader)
+        mod = importlib.util.module_from_spec(spec)
+        loader.exec_module(mod)
+        return mod, path
+    except Exception as e:  # noqa: BLE001 - a broken helper must not kill the daemon
+        log.error(f"LampArray: failed to import {path}: {e}")
+        return None, ""
+
+
+def _hex_to_rgb(value: str) -> Tuple[int, int, int]:
+    v = value.strip().lstrip("#")
+    if len(v) == 3:
+        v = "".join(c * 2 for c in v)
+    return int(v[0:2], 16), int(v[2:4], 16), int(v[4:6], 16)
+
+
+def _rgb_to_hex(rgb) -> str:
+    return "%02x%02x%02x" % tuple(max(0, min(255, int(c))) for c in rgb)
+
+
+class LampArrayController:
+    """Per-key RGB control satisfying DAMX's zone-based contract.
+
+    Thread-safety: every public method takes self._lock. The animation thread holds
+    no lock while sleeping, and checks self._stop between frames, so a new command
+    preempts a running effect within one frame (<=33 ms).
+    """
+
+    def __init__(self):
+        self._lock = threading.RLock()
+        self._stop = threading.Event()
+        self._thread: Optional[threading.Thread] = None
+        self._kb = None
+        self._lamps: List[Dict] = []
+        self._module, self._module_path = _load_lamparray()
+        self.device_id = ""
+        self.device_path = ""
+        self.lamp_count = 0
+        # Last committed settings, kept in the exact string shapes the GUI parses.
+        self.state = self._load_state()
+        self._probe()
+
+    # --- discovery ---------------------------------------------------------
+
+    def _probe(self) -> None:
+        """Find and open a LampArray device. Safe to call repeatedly."""
+        if self._module is None:
+            return
+        try:
+            devs = self._module.discover()
+        except Exception as e:  # noqa: BLE001
+            log.error(f"LampArray: discovery failed: {e}")
+            return
+        if not devs:
+            return
+        dev = devs[0]
+        try:
+            self._kb = self._module.LampArray(dev)
+            self._lamps = self._kb.lamps()
+        except Exception as e:  # noqa: BLE001
+            log.error(f"LampArray: cannot open {dev.get('path')}: {e}")
+            self._kb = None
+            return
+        self.device_id = dev["id"]
+        self.device_path = dev["path"]
+        self.lamp_count = self._kb.count
+        log.info(f"LampArray: {self.device_id} on {self.device_path}, "
+                 f"{self.lamp_count} lamps, via {self._module_path}")
+
+    @property
+    def available(self) -> bool:
+        return self._kb is not None
+
+    def describe(self) -> Dict:
+        return {
+            "available": self.available,
+            "device_id": self.device_id,
+            "device_path": self.device_path,
+            "lamp_count": self.lamp_count,
+            "implementation": self._module_path,
+        }
+
+    # --- state persistence -------------------------------------------------
+
+    def _load_state(self) -> Dict:
+        try:
+            with open(STATE_PATH, "r", encoding="utf-8") as f:
+                return json.load(f)
+        except (OSError, ValueError):
+            return {"per_zone_mode": "", "four_zone_mode": ""}
+
+    def _save_state(self) -> None:
+        try:
+            os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
+            with open(STATE_PATH, "w", encoding="utf-8") as f:
+                json.dump(self.state, f, indent=1)
+        except OSError as e:
+            log.warning(f"LampArray: could not persist state: {e}")
+
+    # --- low-level painting ------------------------------------------------
+
+    def _scaled(self, rgb, brightness: int):
+        return tuple(min(255, round(c * brightness / 100)) for c in rgb)
+
+    def _commit(self, mapping: Dict[int, Tuple[int, int, int]]) -> bool:
+        try:
+            self._kb.multi(mapping)
+            return True
+        except OSError as e:
+            log.error(f"LampArray: write failed ({e}); re-probing device")
+            self._kb = None
+            self._probe()
+            return False
+
+    def _fill(self, rgb) -> bool:
+        try:
+            self._kb.fill(rgb)
+            return True
+        except OSError as e:
+            log.error(f"LampArray: fill failed ({e}); re-probing device")
+            self._kb = None
+            self._probe()
+            return False
+
+    # --- animation ---------------------------------------------------------
+
+    def _stop_effect(self) -> None:
+        """Stop any running animation. Caller must NOT hold the lock."""
+        self._stop.set()
+        t = self._thread
+        if t is not None and t.is_alive():
+            t.join(timeout=1.0)
+        self._thread = None
+        self._stop.clear()
+
+    def _start_effect(self, mode, speed, brightness, direction, rgb) -> None:
+        self._stop_effect()
+        self._stop.clear()
+        self._thread = threading.Thread(
+            target=self._run_effect,
+            args=(mode, speed, brightness, direction, rgb),
+            name=f"lamparray-effect-{mode}",
+            daemon=True,
+        )
+        self._thread.start()
+
+    def _run_effect(self, mode, speed, brightness, direction, rgb) -> None:
+        """Render frames until told to stop. Runs on its own thread."""
+        try:
+            interval = max(self._kb.min_interval / 1e6, 0.033)
+        except Exception:  # noqa: BLE001
+            interval = 0.033
+        width = max(getattr(self._kb, "w", 1), 1)
+        height = max(getattr(self._kb, "h", 1), 1)
+        xs = {l["id"]: l["x"] / width for l in self._lamps}
+        ys = {l["id"]: l["y"] / height for l in self._lamps}
+        # speed 0-9 -> a sane multiplier; 0 is slow but not frozen
+        rate = 0.25 + speed * 0.25
+        twinkle: Dict[int, float] = {}
+        t0 = time.time()
+
+        def sc(c):
+            return self._scaled(c, brightness)
+
+        def hsv(h, s=1.0, v=1.0):
+            return sc(tuple(round(c * 255) for c in colorsys.hsv_to_rgb(h % 1.0, s, v)))
+
+        # direction 1 = right-to-left, 2 = left-to-right
+        sign = -1.0 if direction == 1 else 1.0
+
+        log.info(f"LampArray: effect mode={mode} speed={speed} "
+                 f"brightness={brightness} dir={direction} @ {1/interval:.0f}fps")
+        while not self._stop.is_set():
+            t = time.time() - t0
+            m: Dict[int, Tuple[int, int, int]] = {}
+            try:
+                if mode == MODE_BREATH:
+                    k = 0.06 + 0.94 * (math.sin(2 * math.pi * t * rate * 0.25) + 1) / 2
+                    c = sc(tuple(round(v * k) for v in rgb))
+                    m = {i: c for i in xs}
+                elif mode == MODE_NEON:
+                    c = hsv(t * rate * 0.12)
+                    m = {i: c for i in xs}
+                elif mode == MODE_WAVE:
+                    m = {i: hsv(t * rate * 0.2 + sign * -x) for i, x in xs.items()}
+                elif mode == MODE_SHIFT:
+                    base_h = colorsys.rgb_to_hsv(*(v / 255 for v in rgb))[0]
+                    m = {i: hsv(base_h + 0.15 * math.sin(2 * math.pi * (t * rate * 0.3 + sign * x)))
+                         for i, x in xs.items()}
+                elif mode == MODE_ZOOM:
+                    for i in xs:
+                        d = math.hypot(xs[i] - 0.5, (ys[i] - 0.5) * 0.3)
+                        k = (math.sin(2 * math.pi * (t * rate * 0.4 - d * 2.5)) + 1) / 2
+                        m[i] = sc(tuple(round(v * (0.04 + 0.96 * k)) for v in rgb))
+                elif mode == MODE_METEOR:
+                    head = (t * rate * 0.35 * sign) % 1.4 - 0.2
+                    for i, x in xs.items():
+                        d = (x - head) * sign
+                        k = math.exp(-max(d, 0.0) * 9) if d >= -0.02 else 0.0
+                        m[i] = sc(tuple(round(v * k) for v in rgb))
+                elif mode == MODE_TWINKLE:
+                    for i in xs:
+                        e = twinkle.get(i, 0.0)
+                        if e <= 0 and random.random() < 0.012 * (1 + speed * 0.3):
+                            e = 1.0
+                        twinkle[i] = max(0.0, e - interval * (0.7 + rate * 0.5))
+                        m[i] = sc(tuple(round(v * twinkle[i]) for v in rgb))
+                else:
+                    break
+                if m and not self._commit(m):
+                    break
+            except Exception as e:  # noqa: BLE001 - never let a frame kill the thread
+                log.error(f"LampArray: effect frame failed: {e}")
+                break
+            self._stop.wait(interval)
+        log.debug(f"LampArray: effect mode={mode} stopped")
+
+    # --- public API (mirrors DAMXManager's zone contract) ------------------
+
+    def set_per_zone_mode(self, zones: List[str], brightness: int) -> bool:
+        """Paint N equal left-to-right bands. `zones` is a list of rrggbb strings."""
+        if not self.available:
+            return False
+        self._stop_effect()
+        with self._lock:
+            try:
+                cols = [_hex_to_rgb(z) for z in zones]
+            except (ValueError, IndexError):
+                log.error(f"LampArray: bad zone colours {zones}")
+                return False
+            if not cols:
+                return False
+            width = max(getattr(self._kb, "w", 1), 1)
+            n = len(cols)
+            mapping = {}
+            for l in self._lamps:
+                idx = min(int(l["x"] / width * n), n - 1)
+                mapping[l["id"]] = self._scaled(cols[idx], brightness)
+            self._kb.autonomous(False)
+            if not self._commit(mapping):
+                return False
+            self.state["per_zone_mode"] = ",".join(zones) + f",{brightness}"
+            self.state["four_zone_mode"] = ""
+            self._save_state()
+            log.info(f"LampArray: zones {zones} @ {brightness}%")
+            return True
+
+    def set_four_zone_mode(self, mode: int, speed: int, brightness: int,
+                           direction: int, red: int, green: int, blue: int) -> bool:
+        """Static colour (mode 0) or a rendered animation (modes 1-7)."""
+        if not self.available:
+            return False
+        self._stop_effect()
+        with self._lock:
+            rgb = (red, green, blue)
+            if mode == MODE_STATIC:
+                self._kb.autonomous(False)
+                if not self._fill(self._scaled(rgb, brightness)):
+                    return False
+            elif mode in ANIMATED_MODES:
+                self._kb.autonomous(False)
+                self._start_effect(mode, speed, brightness, direction, rgb)
+            else:
+                log.error(f"LampArray: unsupported mode {mode}")
+                return False
+            self.state["four_zone_mode"] = \
+                f"{mode},{speed},{brightness},{direction},{red},{green},{blue}"
+            self.state["per_zone_mode"] = ""
+            self._save_state()
+            return True
+
+    def get_per_zone_mode(self) -> str:
+        return self.state.get("per_zone_mode", "")
+
+    def get_four_zone_mode(self) -> str:
+        return self.state.get("four_zone_mode", "")
+
+    def restore(self) -> bool:
+        """Re-apply the last committed setting (firmware does not persist colours)."""
+        if not self.available:
+            return False
+        fz = self.state.get("four_zone_mode", "")
+        pz = self.state.get("per_zone_mode", "")
+        try:
+            if fz:
+                parts = [int(x) for x in fz.split(",")]
+                return self.set_four_zone_mode(*parts)
+            if pz:
+                parts = pz.split(",")
+                return self.set_per_zone_mode(parts[:-1], int(parts[-1]))
+        except (ValueError, TypeError) as e:
+            log.warning(f"LampArray: cannot restore saved state ({e})")
+        return False
+
+    def shutdown(self) -> None:
+        self._stop_effect()
